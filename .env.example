# ── Cron schedule (default: 2am daily) ────────────────────────────────────────
# Standard cron syntax: min hour day month weekday
CRON_SCHEDULE=0 2 * * *

# ── License config ─────────────────────────────────────────────────────────────
# enterprise | business
TARGET_EDITION=enterprise

# Refresh when this many days remain before expiry (default: 1.5)
REFRESH_THRESHOLD_DAYS=1.5

# Path to accounts storage file (mount as Docker volume to persist between runs)
ACCOUNTS_FILE=./accounts.json

# ── Local Docmost instance ─────────────────────────────────────────────────────
# Required to activate a refreshed license. Script exits early without these.
DOCMOST_LOCAL_URL=https://your-docmost.example.com
DOCMOST_API_KEY=your-local-api-key
